#!/bin/sh
# push 전 필수 검사 — 실패하면 push 차단 (scripts/prepush_check.py). 설치: sh scripts/install_hooks.sh
# 우회(git push --no-verify) 금지 — docs/desk_kb/LOOP.md 커밋 규약.
ROOT="$(git rev-parse --show-toplevel)" || exit 1
# 훅이 물려받은 GIT_DIR·GIT_INDEX_FILE 등이 검사 안의 임시 git 명령을 실제 저장소로 돌리지 않게 (10/21 core.bare 사고)
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_QUARANTINE_PATH
cd "$ROOT" || exit 1
PY="$(command -v python3 || command -v python)"
exec "$PY" "$ROOT/scripts/prepush_check.py" --hook
